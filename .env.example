# Copy to .env, then fill every REQUIRED value. .env is git-ignored; never commit it.

# --- database (REQUIRED) ---
POSTGRES_USER=zubie
# Generate: python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=
POSTGRES_DB=zubie

# --- backend ---
# REQUIRED. 32+ random characters. The backend refuses to start with a placeholder.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
ZUBIE_SECRET_KEY=
# REQUIRED. The exact origin(s) the dashboard is served from. No wildcard.
ZUBIE_CORS_ORIGINS=http://localhost:3010
ZUBIE_TELEMETRY_INTERVAL=2
# true plants the public demo accounts (demo@zubie.ir). Leave false for a real deployment.
ZUBIE_SEED_DEMO=false
# Proxy IPs trusted to set X-Forwarded-For (your reverse proxy). Keep 127.0.0.1 if it runs on this host.
FORWARDED_ALLOW_IPS=127.0.0.1

# --- host bindings (loopback by default; put a TLS reverse proxy in front) ---
API_BIND=127.0.0.1
API_PORT=8010
WEB_BIND=127.0.0.1
WEB_PORT=3010

# --- what the BROWSER calls (baked into the frontend at build time) ---
PUBLIC_API_URL=http://localhost:8010
PUBLIC_WS_URL=ws://localhost:8010
