# Copy to .env and adjust before `docker compose up`.

# --- database ---
POSTGRES_USER=zubie
POSTGRES_PASSWORD=zubie_dev_password
POSTGRES_DB=zubie

# --- backend ---
ZUBIE_SECRET_KEY=please-change-this-to-a-long-random-string
ZUBIE_CORS_ORIGINS=http://localhost:3010,http://127.0.0.1:3010
ZUBIE_TELEMETRY_INTERVAL=2

# --- ports on the host ---
API_PORT=8010
WEB_PORT=3010

# --- what the browser calls (must be reachable from the user's machine) ---
PUBLIC_API_URL=http://localhost:8010
PUBLIC_WS_URL=ws://localhost:8010
