# Zubie Iran - backend (local development). docker-compose.yml reads the repo-root .env instead.
ZUBIE_ENVIRONMENT=development
# Development accepts the built-in dev secret. Production (ZUBIE_ENVIRONMENT=production) requires a
# random 32+ character value: python -c "import secrets; print(secrets.token_urlsafe(48))"
# ZUBIE_SECRET_KEY=
ZUBIE_DATABASE_URL=sqlite+aiosqlite:///./zubie.db
ZUBIE_CORS_ORIGINS=http://localhost:3010,http://127.0.0.1:3010
ZUBIE_ACCESS_TOKEN_EXPIRE_MINUTES=480
ZUBIE_TELEMETRY_INTERVAL=2
